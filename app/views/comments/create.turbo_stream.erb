<%# シートの中身を再描画（エラー表示含む） %>
<%= turbo_stream.replace "comments_sheet_frame" do %>
  <%# ref: comments_controller#create で @comment/@post はセット済み %>
  <%# 成功時は再取得が必要なので sheet アクション相当のデータを用意するか、あるいはここで再取得するか %>
  <%# controllerで @comments をセットしていないため、ここでロードする %>
  <% @comments = @post.comments.includes(:user).order(created_at: :asc) %>
  <%= render "comments/sheet_frame", post: @post, comments: @comments, comment: (@comment.persisted? ? @post.comments.build : @comment) %>
<% end %>

<%# 💬件数バッジを更新 %>
<%= turbo_stream.replace "comments-count-#{@post.id}" do %>
  <span id="comments-count-<%= @post.id %>"><%= @post.comments.count %></span>
<% end %>
