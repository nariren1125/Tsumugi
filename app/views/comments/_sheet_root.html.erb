<div
  id="comments-sheet"
  class="fixed inset-0 hidden z-bottom-sheet"
  data-controller="comments-sheet"
>
  <div
    class="absolute inset-0 bg-black/60"
    data-action="click->comments-sheet#close"
  ></div>

  <div class="absolute bottom-0 left-0 right-0 flex justify-center pb-2">
    <div class="w-full max-w-md bg-base-100 rounded-t-2xl shadow-xl max-h-[85vh] flex flex-col">
      <div class="px-4 pt-3 pb-2 border-b border-base-200">
        <div class="mx-auto w-10 h-1 rounded-full bg-base-300"></div>
        <div class="mt-3 flex items-center justify-between">
          <div class="w-10"></div>
          <h3 class="font-bold">コメント</h3>
          <button class="w-10 text-right" data-action="click->comments-sheet#close">×</button>
        </div>
      </div>

      <turbo-frame id="comments_sheet_frame">
        <div class="px-4 py-6 text-sm opacity-60">読み込み中...</div>
      </turbo-frame>
    </div>
  </div>
</div>
