<div
  id="comments-sheet"
  class="fixed inset-0 hidden z-[1130]"
  data-controller="comments-sheet"
>
  <div
    class="absolute inset-0 bg-black/60"
    data-comments-sheet-target="backdrop"
    data-action="click->comments-sheet#close"
  ></div>

  <div class="absolute bottom-0 left-0 right-0 flex justify-center">
    <div
      class="w-full max-w-md bg-base-100 rounded-t-2xl shadow-xl h-[70vh] flex flex-col pb-[env(safe-area-inset-bottom)] overflow-hidden"
      data-comments-sheet-target="panel"
    >
      <!-- 👇 ドラッグ開始はこのヘッダーのみ -->
      <div
        class="px-4 pt-3 pb-2 border-b border-base-200 select-none"
        data-comments-sheet-target="handle"
        data-action="pointerdown->comments-sheet#startDrag pointermove->comments-sheet#onDrag pointerup->comments-sheet#endDrag pointercancel->comments-sheet#endDrag"
        style="touch-action: none;"
      >
        <div class="mx-auto w-10 h-1 rounded-full bg-base-300"></div>
        <div class="mt-3 flex items-center justify-between">
          <div class="w-10"></div>
          <h3 class="font-bold">コメント</h3>
          <button class="w-10 text-right" data-action="click->comments-sheet#close">×</button>
        </div>
      </div>

      <turbo-frame
        id="comments_sheet_frame"
        class="flex-1 overflow-y-auto overscroll-contain"
      >
        <div class="px-4 py-6 text-sm opacity-60">読み込み中...</div>
      </turbo-frame>
    </div>
  </div>
</div>


<!-- 削除モーダル（アクションモーダル） -->
<div
  id="comment-actions"
  class="fixed inset-0 hidden z-[1200]"
  data-controller="comment-actions"
>
  <div class="absolute inset-0 bg-black/40" data-action="click->comment-actions#close"></div>

  <div class="absolute left-1/2 top-1/2 w-64 -translate-x-1/2 -translate-y-1/2 rounded-xl bg-base-100 shadow-xl overflow-hidden text-sm">
    <button type="button" class="w-full px-5 py-3.5 text-left text-error hover:bg-base-200 transaction-colors font-medium border-b border-base-200"
      data-comment-actions-target="deleteButton"
      data-action="click->comment-actions#delete">
      🗑️ 削除
    </button>
    <button type="button" class="w-full px-5 py-3.5 text-left hover:bg-base-200 transaction-colors font-medium text-base-content/70"
      data-action="click->comment-actions#close">
      キャンセル
    </button>
  </div>
</div>
