<div
  id="comments-sheet-<%= post.id %>"
  class="fixed inset-0 z-bottom-sheet hidden"
  data-controller="comments-sheet"
>
  <!-- 背景 -->
  <div
    class="absolute inset-0 bg-black/60"
    data-comments-sheet-target="backdrop"
    data-action="click->comments-sheet#close"
  ></div>

  <!-- シート中央寄せラッパー -->
  <div class="absolute bottom-0 left-0 right-0 flex justify-center pb-2">
    <div
      class="w-full max-w-md bg-base-100 rounded-t-2xl shadow-xl max-h-[85vh] flex flex-col"
      data-comments-sheet-target="panel"
      data-action="pointerdown->comments-sheet#start pointermove->comments-sheet#move pointerup->comments-sheet#end pointercancel->comments-sheet#end"
    >

      <!-- ヘッダー -->
      <div class="px-4 pt-3 pb-2 border-b border-base-200">
        <div class="mx-auto w-10 h-1 rounded-full bg-base-300"></div>
        <div class="mt-3 flex items-center justify-between">
          <div class="w-10"></div>
          <h3 class="font-bold">コメント</h3>
          <button
            class="w-10 text-right"
            data-action="click->comments-sheet#close"
          >×</button>
        </div>
      </div>

      <!-- コメント一覧 -->
      <div class="px-4 py-3 max-h-[85vh] overflow-y-auto space-y-4">
        <% post.comments.includes(:user).order(created_at: :asc).each do |comment| %>
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 text-sm leading-relaxed">
              <span class="font-semibold"><%= comment.user.name %></span>
              <span class="ml-2 whitespace-pre-wrap break-words"><%= h(comment.body) %></span>
            </div>

            <button class="shrink-0 text-sm opacity-70 hover:opacity-100">♡</button>
          </div>
        <% end %>
      </div>

      <!-- 入力欄 -->
      <div class="px-4 py-3 border-t border-base-200">
        <%= form_with model: [post, Comment.new], local: true, class: "flex items-end gap-2" do |f| %>
          <%= f.text_area :body, rows: 1, placeholder: "コメントを追加...", class: "textarea textarea-bordered w-full rounded-xl" %>
          <%= f.submit "送信", class: "btn btn-neutral rounded-full px-5" %>
        <% end %>
      </div>

    </div>
  </div>
</div>
