<% content_for :suppress_header, true %>

<%= render "shared/help_header",
      title: "お問い合わせ",
      back_path: faq_path,
      back_aria: "よくある質問に戻る" %>

<div class="max-w-xl mx-auto px-4 pt-16 pb-28">

  <div class="bg-base-100 rounded-box shadow p-6 space-y-5">

    <p class="text-sm text-base-content/80">
      お困りごとが解決しない場合は、こちらからお問い合わせください。
      内容を確認し、必要に応じてご連絡いたします。
    </p>

    <%= form_with model: @contact, url: contact_path, method: :post, local: true, class: "space-y-4" do |f| %>

      <% if @contact.errors.any? %>
        <div class="alert alert-error text-sm">
          <span>入力内容をご確認ください。</span>
        </div>
      <% end %>

      <div class="form-control">
        <%= f.label :category, "カテゴリ（任意）", class: "label text-sm font-semibold" %>
        <%= f.select :category,
              options_for_select(ContactForm::CATEGORIES, @contact.category),
              { include_blank: "選択してください" },
              class: "select select-bordered w-full" %>
      </div>

      <div class="form-control">
        <%= f.label :name, "お名前（任意）", class: "label text-sm font-semibold" %>
        <%= f.text_field :name, class: "input input-bordered w-full", maxlength: 50 %>
      </div>

      <div class="form-control">
        <%= f.label :email, "メールアドレス（任意）", class: "label text-sm font-semibold" %>
        <%= f.email_field :email, class: "input input-bordered w-full", autocomplete: "email" %>
        <% if @contact.errors[:email].any? %>
          <p class="mt-1 text-xs text-error"><%= @contact.errors[:email].first %></p>
        <% end %>
      </div>

      <div class="form-control">
        <%= f.label :message, "お問い合わせ内容（必須）", class: "label text-sm font-semibold" %>
        <%= f.text_area :message, rows: 6, class: "textarea textarea-bordered w-full", maxlength: 2000 %>
        <% if @contact.errors[:message].any? %>
          <p class="mt-1 text-xs text-error"><%= @contact.errors[:message].first %></p>
        <% end %>
      </div>

      <%= f.submit "送信する", class: "btn btn-accent w-full" %>

      <p class="text-xs text-base-content/70 text-center">
        ※ 返信が必要な場合は、メールアドレスの入力をお願いします。
      </p>
    <% end %>

  </div>
</div>
