<h1>家族グループを作成</h1>

<%= form_with model: @family_group, local: true do |f| %>
  <div class="form-control mb-4">
    <label class="label">
      <span class="label-text">家族名</span>
    </label>
    <%= f.text_field :name, class: "input input-bordered w-full" %>
  </div>

  <%= f.submit "作成する", class: "btn btn-primary w-full" %>
<% end %>
