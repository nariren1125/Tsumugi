<!-- モーダルトグル -->
<input type="checkbox" id="child-age-modal" class="modal-toggle" />

<div
  class="modal z-overlay"
  data-controller="child-age"
  data-child-age-ages-by-child-value="<%= @ages_by_child_id.to_json %>"
>
  <div class="modal-box max-w-md relative z-modal">
    <h3 class="font-semibold text-base mb-2">子どもと年齢を選択</h3>

    <p class="text-xs text-base-content/60 mb-4">
      子どもと年齢を指定すると、その期間に撮影された思い出を表示します。
    </p>

    <div class="mb-3">
      <label class="block text-sm font-semibold mb-1">子ども</label>
      <select
        class="select select-bordered w-full"
        data-child-age-target="childSelect"
        data-action="change->child-age#childChanged"
      >
        <option value="">選択してください</option>
        <% children.each do |c| %>
          <option value="<%= c.id %>"><%= c.name %></option>
        <% end %>
      </select>
    </div>

    <div class="mb-1">
      <label class="block text-sm font-semibold mb-1">年齢</label>
      <select
        class="select select-bordered w-full"
        data-child-age-target="ageSelect"
      >
        <!-- JSで差し込む -->
      </select>
      <p class="text-xs opacity-70 mt-1">0歳＝0ヶ月以上〜1歳未満</p>
    </div>

    <div class="modal-action">
      <label
        for="child-age-modal"
        class="btn btn-ghost btn-sm"
        data-action="click->child-age#cancel"
      >
        キャンセル
      </label>

      <label
        for="child-age-modal"
        class="btn btn-accent btn-sm"
        data-action="click->child-age#apply"
      >
        完了する
      </label>
    </div>
  </div>
</div>
