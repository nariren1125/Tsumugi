<div class="max-w-xl mx-auto px-4 py-10 pb-24">
  <% if @posts_by_year.present? %>

    <% @posts_by_year.each do |year, posts| %>
      <%# 年ヘッダー表示 %>
      <% if year == "撮影日未設定" %>
        <h2>…未設定の見出し…</h2>
      <% else %>
        <h2><%= year %>年</h2>
      <% end %>

      <%# 投稿カード一覧 %>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <% posts.each do |post| %>
          <%= render "postcard/card", post: post %>
        <% end %>
      </div>
    <% end %>

    <%# 投稿がある場合のモーダルウィンドウをまとめてレンダリング %>
    <% @posts_by_year.each do |_, posts| %>
      <% posts.each do |post| %>
        <%= render "posts/modal", post: post %>
      <% end %>
    <% end %>

  <% else %>
    <%# 投稿なしの表示 %>
    <div class="text-center py-20 space-y-6">
      <!-- 添付画像 -->
      <div class="w-40 mx-auto animate-bounce">
        <%= image_tag "思い出なしアルバム一覧.png", alt: "アルバムが空の状態", class: "w-full h-auto" %>
      </div>

      <!-- 優しいメッセージ -->
      <h2 class="text-lg font-semibold text-base-content/80">
        まだ思い出が投稿されていません
      </h2>
      <p class="text-sm text-base-content/60">
        思い出を投稿して、アルバムを作りましょう。
      </p>

      <!-- CTAボタン -->
      <%= link_to "思い出を投稿する", new_post_path,
            class: "btn btn-accent mt-4" %>
    </div>
  <% end %>
</div>
