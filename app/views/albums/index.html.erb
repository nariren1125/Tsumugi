<%# デフォルトヘッダー、デフォルト背景を制御 %>
<% content_for :suppress_header, true %>

<div class="relative min-h-screen">
  <!-- ===== ヘッダー ===== -->
  <%= render "shared/simple_header", title: "アルバム一覧" %>

  <div class="max-w-xl mx-auto px-4 py-10 pb-24">
    <!-- ===== 検索（省スペース） ===== -->
    <div class="mb-6">
      <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input
          type="checkbox"
          <%= (params[:year].present? || params[:child_id].present? || params[:age_years].present? || Array(params[:person_tag_ids]).present?) ? "checked" : "" %>
        />

        <div class="collapse-title text-sm font-semibold">
          検索機能

          <%# 条件の要約（chips） %>
          <span class="ml-2 text-xs opacity-70">
            <% summaries = [] %>
            <% summaries << "#{params[:year]}年" if params[:year].present? %>

            <% person_ids = Array(params[:person_tag_ids]).reject(&:blank?) %>
            <% summaries << "メンバー:#{person_ids.size}人" if person_ids.any? %>

            <% if params[:child_id].present? && params[:age_years].present? %>
              <% child = @children.find { |c| c.id.to_s == params[:child_id].to_s } %>
              <% summaries << "#{child&.name} #{params[:age_years]}歳" %>
            <% end %>

            <%= summaries.any? ? summaries.join(" / ") : "条件なし" %>
          </span>
        </div>

        <div class="collapse-content">
          <%= form_with url: albums_path, method: :get, local: true do %>
            <div class="space-y-4">
              <% age_mode = params[:child_id].present? && params[:age_years].present? %>

              <!-- 年 -->
              <div>
                <label class="block text-sm font-semibold mb-1">年度（年）</label>
                <select name="year" class="select select-bordered w-full" <%= "disabled" if age_mode %>>
                  <option value="">指定しない</option>
                  <% Date.current.year.downto(Date.current.year - 10).each do |y| %>
                    <option value="<%= y %>" <%= "selected" if params[:year].to_s == y.to_s %>><%= y %>年</option>
                  <% end %>
                </select>

                <% if age_mode %>
                  <p class="text-xs opacity-70 mt-1">
                    年齢で絞り込み中のため年はロックされています（年を変更すると年齢指定は解除してください）。
                  </p>
                <% end %>
              </div>

              <%# ===== 誰が写ってる？（モーダル + チップ） ===== %>
              <div data-controller="person-tags">
                <div class="flex items-center justify-between mb-1 gap-2">
                  <span class="label font-medium text-base-content">誰が写っている？</span>

                  <% if @person_tags.any? %>
                    <label
                      for="person-tags-modal"
                      class="btn btn-sm btn-outline normal-case"
                      data-action="click->person-tags#open"
                    >
                      選択する
                    </label>
                  <% end %>
                </div>

                <% selected_ids = Array(params[:person_tag_ids]).reject(&:blank?).map(&:to_s) %>

                <!-- 選択結果の表示 -->
                <div
                  class="input input-bordered input-auto-height w-full flex flex-wrap gap-2 text-xs px-3 py-2"
                  data-person-tags-target="selectedList"
                >
                  <%# JSで上書きされるが、初期表示も入れておく %>
                  <% if @person_tags.any? %>
                    <% selected = @person_tags.select { |t| selected_ids.include?(t.id.to_s) } %>

                    <% if selected.any? %>
                      <% selected.each do |t| %>
                        <span class="badge badge-primary badge-sm"><%= t.name %></span>
                      <% end %>
                    <% else %>
                      <span class="text-base-content/50">まだ選択されていません</span>
                    <% end %>
                  <% else %>
                    <span class="text-base-content/50">タグを作成すると、ここに選択した名前が表示されます</span>
                  <% end %>
                </div>

                <%# hidden checkboxes（フォーム送信用） %>
                <% if @person_tags.any? %>
                  <div class="hidden">
                    <% @person_tags.each do |tag| %>
                      <input
                        type="checkbox"
                        name="person_tag_ids[]"
                        value="<%= tag.id %>"
                        data-person-tags-target="checkbox"
                        data-name="<%= tag.name %>"
                        <%= "checked" if selected_ids.include?(tag.id.to_s) %>
                      />
                    <% end %>
                  </div>
                <% end %>

                <%= render "albums/person_tags_modal", person_tags: @person_tags %>
              </div>

              <%# ===== 子ども年齢（モーダル + 表示 + hidden） ===== %>
<div data-controller="child-age">
  <div class="flex items-center justify-between mb-1 gap-2">
    <span class="label font-medium text-base-content">子ども年齢</span>

    <% if @children.any? %>
      <label
        for="child-age-modal"
        class="btn btn-sm btn-outline normal-case"
        data-action="click->child-age#open"
      >
        選択する
      </label>
    <% end %>
  </div>

  <%# 表示エリア（チップ） %>
  <div
    class="input input-bordered input-auto-height w-full flex flex-wrap gap-2 text-xs px-3 py-2"
    data-child-age-target="selectedLabel"
  >
    <span class="text-base-content/50">まだ選択されていません</span>
  </div>

  <%# hidden（フォーム送信用） %>
  <input type="hidden" name="child_id" data-child-age-target="childHidden" value="<%= params[:child_id].to_s %>">
  <input type="hidden" name="age_years" data-child-age-target="ageHidden" value="<%= params[:age_years].to_s %>">

  <%= render "albums/child_age_modal", children: @children %>
</div>


              <div class="flex gap-2">
                <button type="submit" class="btn btn-primary flex-1">絞り込む</button>
                <%= link_to "リセット", albums_path, class: "btn btn-ghost" %>
              </div>

              <% if params[:year].present? || (params[:child_id].present? && params[:age_years].present?) %>
                <p class="text-xs opacity-70">※年／年齢で絞り込む場合、撮影日未設定の思い出は表示されません</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ===== 結果一覧 ===== %>
    <% if @posts_by_year.present? %>
      <% @posts_by_year.each do |year, posts| %>
        <% if year == "撮影日未設定" %>
          <h2 class="text-lg font-semibold mt-8 mb-4">撮影日未設定</h2>
        <% else %>
          <h2 class="text-lg font-semibold mt-8 mb-4"><%= year %>年</h2>
        <% end %>

        <div class="relative mb-8">
          <div class="absolute top-4 left-0 w-full h-px bg-base-300"></div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 pt-8">
            <% posts.each do |post| %>
              <%= render "postcard/card", post: post %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# モーダル %>
      <% @posts_by_year.each do |_, posts| %>
        <% posts.each do |post| %>
          <%= render "posts/modal", post: post %>
        <% end %>
      <% end %>
    <% else %>
      <%= render "albums/empty" %>
    <% end %>
  </div>
</div>
