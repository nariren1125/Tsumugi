<%# デフォルトヘッダー、デフォルト背景を制御 %>
<% content_for :suppress_header, true %>
<!-- ===== body controller 指定 ===== -->
<% content_for :body_controllers, "person-tags" %>

<div class="relative min-h-screen">

  <!-- ===== header ===== -->
  <%= render "albums/header",
    family_groups: @family_groups,
    current_family_group: current_family_group %>

  <div class="max-w-xl mx-auto px-4 py-10 pb-24">
    <!-- ===== 検索（省スペース） ===== -->
    <%= render "albums/search",
    available_years: @available_years,
    person_tags: @person_tags,
    children: @children,
    params: params %>

    <%# ===== 結果一覧（※ここも max-w-xl の中！） ===== %>
    <%= render "albums/posts_grid", posts_by_year: @posts_by_year %>

  </div> <!-- /.max-w-xl -->
</div>   <!-- /.min-h-screen -->

<%# ==== アルバム一覧ページ専用モーダル（body 直下で描画） ==== %>
<%= render "albums/modals",
    posts_by_year: @posts_by_year,
    person_tags: @person_tags,
    children: @children,
    ages_by_child_id: @ages_by_child_id %>

<%# ==== コメント用 bottom sheet（ページに1個だけ） ==== %>
<%= render "comments/sheet_root" %>
