
<% header_title = capture do %>
  <% if family_groups.present? && family_groups.size > 1 %>
    <div class="relative" data-controller="dropdown">
      <button
        type="button"
        class="btn btn-ghost btn-sm normal-case px-0 gap-1 max-w-[70vw]"
        data-action="click->dropdown#toggle"
      >
        <span class="text-base font-semibold truncate max-w-[60vw] inline-block">
          <%= album_index_header_title %>
        </span>
        <span class="text-base opacity-60">▾</span>
      </button>

      <div
        class="absolute top-full left-0 mt-2 min-w-[12rem] max-w-[80vw] rounded-box bg-base-100 shadow z-dropdown
               opacity-0 scale-95 pointer-events-none transition duration-150 origin-top"
        data-dropdown-target="menu"
      >
        <ul class="menu p-2 whitespace-nowrap">
          <% family_groups.each do |fg| %>
            <% active = (current_family_group&.id == fg.id) %>

            <li>
              <%= link_to switch_albums_path(family_group_id: fg.id),
                    data: { turbo_method: :post, action: "click->dropdown#close" },
                    class: "flex items-center gap-2 #{active ? 'active font-semibold' : ''}" do %>
                <span class="w-4 text-center"><%= active ? "✓" : "" %></span>
                <span class="truncate"><%= fg.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% else %>
    <span class="text-base font-semibold"><%= album_index_header_title %></span>
  <% end %>
<% end %>

<%= render "shared/simple_header", title: header_title %>
