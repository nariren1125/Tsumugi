<div class="min-h-screen bg-base-200">
  <div class="max-w-xl mx-auto px-6 pt-6 pb-16">

    <!-- タイトル -->
    <div class="text-center mb-8">
      <p class="mt-4 text-base text-base-content/80 leading-relaxed">
        Tsumugiは、<br>
        <span class="font-semibold">LINE内でご利用いただくアプリになります</span>
      </p>
    </div>

    <% line_url = ENV.fetch("LINE_OFFICIAL_ACCOUNT_URL", "https://lin.ee/EVyr20P") %>

    <!-- 説明カード -->
    <div class="bg-base-100 rounded-box shadow p-6 text-center">
      <p class="text-sm text-base-content/70 leading-relaxed mb-8">
        ご利用の際は、<br>
        <span class="font-semibold">
          TsumugiのLINE公式アカウントを友だちに追加し、<br>
          リッチメニューからアクセスしてください。
        </span>
      </p>

      <!-- 画像リンク（メインCTA） -->
      <div class="flex flex-col items-center gap-2">
        <a href="<%= line_url %>" target="_blank" rel="noopener">
          <%= image_tag "tsumugi_access.png",
                alt: "LINE公式アカウントを開く",
                class: "w-full rounded-xl shadow-lg hover:opacity-90 transition" %>
        </a>

        <!-- 補足文 -->
        <p class="text-xs text-base-content/60">
          ※ 画像をタップしてLINEを開く
        </p>
      </div>
    </div>

    <!-- 利用の流れ -->
    <div class="mt-8 bg-base-100 rounded-box shadow p-6">
      <h2 class="font-bold mb-4 text-center">ご利用の流れ</h2>

      <ol class="list-decimal list-inside text-sm text-base-content/70 space-y-2 leading-relaxed">
        <li>LINE公式アカウントを友だちに追加</li>
        <li>トーク画面を開くとリッチメニューが表示されます</li>
        <li>「<span class="font-semibold">思い出を紡ごう</span>」をタップ</li>
        <li>LINEアカウントで登録・ログイン</li>
        <li>すぐにTsumugiをご利用いただけます</li>
      </ol>
    </div>

    <!-- ✅ Xアプリ内ブラウザ対策（図解） -->
    <div class="mt-6 bg-base-100 rounded-box shadow p-6">
      <h3 class="font-bold mb-3 text-center">Xから開けない場合の対処</h3>

      <p class="text-sm text-base-content/70 leading-relaxed mb-4">
        Xのアプリ内ブラウザでは、LINE公式アカウントが開けない場合があります。<br>
        その場合は、下の画像の順番のように <span class="font-semibold">「ブラウザで開く」</span> を選択して操作を進めてください。
      </p>

      <div class="flex justify-center">
        <%= image_tag "x_inapp_open_browser_guide.png",
              alt: "Xアプリ内ブラウザで「ブラウザで開く」を選ぶ手順",
              class: "w-full max-w-sm rounded-xl border border-base-300 shadow" %>
      </div>

      <p class="text-xs text-base-content/60 mt-3 text-center">
        ※ 画面表示は端末やXのバージョンで異なる場合があります
      </p>
    </div>

    <!-- 補足リンク -->
    <div class="mt-8 bg-base-100 rounded-box shadow p-6 text-center">
      <p class="text-sm text-base-content/70 mb-4">
        ブラウザから直接アクセスした場合は、<br>
        この案内画面が表示されます。
      </p>

      <div class="flex justify-center gap-3 flex-wrap">
        <%= link_to "Tsumugiとは", about_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "使い方", how_to_use_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "よくある質問", faq_path, class: "btn btn-ghost btn-sm" %>
      </div>
    </div>

    <!-- フッター -->
    <div class="mt-10 text-center text-xs text-base-content/60">
      <div class="flex justify-center gap-4 flex-wrap mb-3">
        <%= link_to "利用規約", terms_path, class: "link link-hover" %>
        <%= link_to "プライバシーポリシー", privacy_path, class: "link link-hover" %>
      </div>

      <p>© <%= Time.current.year %> Tsumugi</p>
    </div>

  </div>
</div>
