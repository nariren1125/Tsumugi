<!-- 投稿ページヘッダー抑制 -->
<% content_for :suppress_header, true %>
<!-- ===== body controller 指定 ===== -->
<% content_for :body_controllers, "person-tags draft-exit" %>

<!-- 投稿ページカスタムヘッダー -->
<div class="fixed top-0 left-0 w-full z-50 flex items-center justify-between
            bg-base-300 text-base-content px-4 py-3
            border-b border-base-200">

  <!-- ×（編集破棄シート） -->
  <div class="w-20 flex-shrink-0">
    <button
      type="button"
      class="text-2xl leading-none"
      aria-label="閉じる"
      data-action="click->draft-exit#open"
    >
      ×
    </button>
  </div>

  <h2 class="text-base font-bold text-center flex-grow truncate">
    思い出を投稿
  </h2>

  <div class="w-20 flex-shrink-0"></div>
</div>

<div class="max-w-xl mx-auto px-4 pt-20 pb-20">
  <!-- サムネ -->
  <div class="flex justify-center gap-2 mb-2">
    <% Array(@pending_blobs).each do |blob| %>
      <div class="w-14 aspect-square rounded-md overflow-hidden">
        <%= image_tag blob, class: "w-full h-full object-cover", loading: "lazy", decoding: "async" %>
      </div>
    <% end %>
  </div>

  <p class="text-[11px] text-base-content/60 text-center">
    選択した写真（変更できません）
  </p>

  <div class="space-y-3 bg-base-100 rounded-box shadow p-4">

    <%= render "shared/form_errors", object: @post %>

    <!-- ✅ 通常投稿フォーム -->
    <%= form_with model: @post,
                  local: true,
                  data: { turbo: false },
                  html: { id: "post-form", multipart: true, novalidate: true } do |f| %>

      <div class="mb-3">
        <%= f.label :photo_date, "撮影日", class: "label py-1 font-medium text-base-content" %>
        <%= f.date_field :photo_date, class: "input input-bordered w-full h-10", required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :title, "タイトル", class: "label py-1 font-medium text-base-content" %>
        <%= f.text_field :title, class: "input input-bordered w-full h-10", placeholder: "例：はじめての公園遊び" %>
      </div>

      <%= render "person_tags_field", f: f %>

      <div class="mb-2">
        <%= f.label :content, "メッセージ", class: "label py-1 font-medium text-base-content" %>
        <%= f.text_area :content, rows: 2, placeholder: "今日の思い出をひとことで", class: "textarea textarea-bordered w-full" %>
      </div>

      <div class="mt-3 flex gap-2">
        <%= f.submit "投稿する",
              class: "btn btn-accent hover:brightness-110 active:scale-95 transition duration-150 w-full" %>
      </div>

    <% end %>
  </div>
</div>

<!-- ✅ モーダル（アクションシート） -->
<div class="modal" data-draft-exit-target="modal">
  <div class="modal-box w-full max-w-md p-0 rounded-t-2xl fixed bottom-0 left-1/2 -translate-x-1/2">
    <div class="p-5">
      <p class="text-sm text-base-content/70">
        このまま戻ると、編集は破棄されます。
      </p>

      <div class="mt-4 space-y-2">
        <button type="button"
                class="btn btn-outline w-full"
                data-action="click->draft-exit#discard">
          破棄
        </button>

        <button type="button"
                class="btn btn-accent w-full"
                data-action="click->draft-exit#save">
          下書きを保存
        </button>
      </div>
    </div>

    <div class="p-4 bg-base-200">
      <button type="button"
              class="btn w-full"
              data-action="click->draft-exit#close">
        キャンセル
      </button>
    </div>
  </div>

  <div class="modal-backdrop">
    <button type="button" data-action="click->draft-exit#close">close</button>
  </div>
</div>

<!-- ✅ 破棄用フォーム -->
<%= form_with url: discard_draft_posts_path,
              method: :post,
              local: true,
              data: { turbo: false, draft_exit_target: "discardForm" } do %>
<% end %>

<!-- ✅ 下書き保存用フォーム -->
<%= form_with model: @post,
              url: save_draft_posts_path,
              method: :post,
              local: true,
              data: { turbo: false, draft_exit_target: "draftForm" } do |df| %>

  <%= df.hidden_field :photo_date %>
  <%= df.hidden_field :title %>
  <%= df.hidden_field :content %>

  <div data-draft-exit-target="personTagsHolder"></div>
<% end %>
