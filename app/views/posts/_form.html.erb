<!-- 投稿ページヘッダー抑制 -->
<% content_for :suppress_header, true %>
<!-- ===== body controller 指定 ===== -->
<% content_for :body_controllers, "person-tags" %>

<!-- 投稿ページカスタムヘッダー -->
<div class="fixed top-0 left-0 w-full z-50 flex items-center justify-between
            bg-base-300 text-base-content px-4 py-3
            border-b border-base-200">

  <!-- 戻る（プレビュー画面へ） -->
  <div class="w-20 flex-shrink-0">
    <%= link_to "←", "javascript:history.back()", class: "text-lg" %>
  </div>

  <!-- タイトル -->
  <h2 class="text-base font-bold text-center flex-grow truncate">
    思い出を投稿
  </h2>

  <!-- 右側ダミー（中央寄せ用） -->
  <div class="w-20 flex-shrink-0"></div>
</div>

<!-- 投稿フォーム本体 -->
<div class="max-w-xl mx-auto px-4 pt-20 pb-20">
  <%# ↑ pt-20 → pt-16（ヘッダー下の余白を少し詰める） %>
  <%# ↑ pb-24 → pb-20（下部ナビがあるので詰めすぎない範囲で短縮） %>

  <%# ✅ 既存の写真がある場合はサムネ表示（高さを抑える） %>
  <div class="flex justify-center gap-2 mb-2">
    <% Array(@pending_blobs).each do |blob| %>
      <div class="w-14 aspect-square rounded-md overflow-hidden">
        <%# w-20 → w-14（縦を圧縮して1画面に寄せる） %>
        <%= image_tag blob,
              class: "w-full h-full object-cover",
              loading: "lazy",
              decoding: "async" %>
      </div>
    <% end %>
  </div>

  <p class="text-[11px] text-base-content/60 text-center">
    <%# mb-2 → mb-3（サムネとのバランスを取りつつ詰める） %>
    選択した写真（変更できません）
  </p>

  <div class="space-y-3 bg-base-100 rounded-box shadow p-4">
    <%# space-y-4 → space-y-3（フォーム全体を圧縮） %>

    <%# ✅ 共通エラーパーツ %>
    <%= render "shared/form_errors", object: @post %>

    <%# turbo: false を指定してTurboフォーム送信を無効化 %>
    <%= form_with model: @post,
                  data: { turbo: false },
                  html: { multipart: true, novalidate: true } do |f| %>

      <%# 撮影日 %>
      <div class="mb-3">
        <%# mb-4 → mb-3 %>
        <%= f.label :photo_date, "撮影日",
              class: "label py-1 font-medium text-base-content" %>
        <%# label の縦paddingを詰める（daisyUI） %>
        <%= f.date_field :photo_date,
              class: "input input-bordered w-full h-10",
              required: true %>
        <%# input を少し低く（h-10） %>
      </div>

      <%# タイトル %>
      <div class="mb-3">
        <%= f.label :title, "タイトル",
              class: "label py-1 font-medium text-base-content" %>
        <%= f.text_field :title,
              class: "input input-bordered w-full h-10",
              placeholder: "例：はじめての公園遊び" %>
      </div>

      <%# 誰が写っているか？（部分テンプレート） %>
      <%= render "person_tags_field", f: f %>

      <%# メッセージ %>
      <div class="mb-2">
        <%# mb-4 → mb-2 %>
        <%= f.label :content, "メッセージ",
              class: "label py-1 font-medium text-base-content" %>
        <%= f.text_area :content,
              rows: 2,
              placeholder: "今日の思い出をひとことで",
              class: "textarea textarea-bordered w-full" %>
        <%# rows: 3 → 2（縦圧縮） %>
      </div>

      <%# 送信ボタン %>
      <div class="mt-3">
        <%# mt-6 → mt-3 %>
        <%= f.submit "投稿する",
              class: "btn btn-accent hover:brightness-110 active:scale-95 transition duration-150 w-full" %>
      </div>

    <% end %>
  </div>
</div>
