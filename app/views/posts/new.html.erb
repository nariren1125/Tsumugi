<% if @post&.errors&.any? %>
  <div class="alert alert-error mb-4">
    <ul>
      <% @post.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<% if @has_family_group %>
  <%= render "form" %>
<% else %>
  <%= render "no_family_group" %>
<% end %>
