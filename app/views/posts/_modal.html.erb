<div id="modal-<%= post.id %>" class="hidden fixed inset-0 z-50 bg-black bg-opacity-50 flex items-center justify-center"
     data-controller="modal">
  <div class="bg-white rounded-lg p-4 w-11/12 max-w-md relative">

    <!-- 閉じるボタン -->
    <button class="absolute top-2 right-2 text-gray-500 text-xl" data-action="click->modal#close">×</button>

    <!-- Swiper スライダー -->
    <% if post.photos.any? %>
      <div class="swiper">
        <div class="swiper-wrapper">
          <% post.photos.each do |photo| %>
            <% if photo.image.attached? %>
              <div class="swiper-slide">
                <%= image_tag photo.image, class: "w-full object-cover rounded" %>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- ドット型ページネーション -->
        <div class="swiper-pagination mt-2"></div>
      </div>
    <% end %>

    <!-- 投稿情報 -->
    <h2 class="text-xl font-bold mt-4"><%= post.title %></h2>
    <p class="text-gray-700 mt-2"><%= post.content %></p>
    <p class="text-sm text-gray-500 mt-1">
      <%= post.photo_date.present? ? l(post.photo_date) : "撮影日未設定" %>
    </p>

    <% if post.user == current_user %>
      <div class="mt-4 text-right space-x-2">
        <%= link_to "編集", edit_post_path(post), class: "text-blue-600" %>
        <%= link_to "削除", post_path(post),
                    method: :delete,
                    data: { confirm: "削除してもよろしいですか？", turbo: false },
                    class: "text-red-600" %>
      </div>
    <% end %>
  </div>
</div>
