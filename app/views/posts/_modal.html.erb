<!-- モーダル本体 -->
<div id="modal-<%= post.id %>" class="fixed inset-0 z-50 bg-black bg-opacity-80 flex items-center justify-center hidden" data-controller="modal">
  <div class="relative bg-black w-full max-w-md h-full overflow-y-auto text-white pt-14 pb-24 rounded-lg">

    <!-- 🟥 固定ヘッダー -->
    <div class="absolute top-0 left-0 w-full z-50 flex items-center justify-between bg-black text-white px-4 py-3">
      <!-- 戻るボタン -->
      <button class="text-xl" data-action="click->modal#close">←</button>
      <!-- タイトル -->
      <h2 class="text-base font-bold text-center flex-grow -ml-6 truncate">
        <%= post.title %>
      </h2>
      <!-- 空白スペース（右寄せ調整） -->
      <div class="w-6"></div>
    </div>

    <!-- 投稿者情報（画像の少し上に表示） -->
      <div class="flex items-center justify-between text-sm text-white px-4 mt-2">
        <div class="flex items-center space-x-2">
          <!-- アバター実装前なので、画像なし or ダミー画像を表示 -->
          <!-- <img src="/default-avatar.png" class="w-6 h-6 rounded-full" alt="avatar"> -->
          <span class="font-medium"><%= post.user.name %></span>
        </div>
        <div class="text-xl cursor-pointer">⋯</div>
      </div>

    <!-- 写真スライダー -->
      <div class="swiper my-2">
        <div class="swiper-wrapper">
          <% post.photos.each do |photo| %>
            <% if photo.image.attached? %>
              <div class="swiper-slide">
                <%= image_tag photo.image, class: "w-full object-cover" %>
              </div>
            <% end %>
          <% end %>
        </div>
        <div class="swiper-pagination mt-2"></div>
      </div>

    <!-- メッセージラベル -->
    <div class="px-4 mt-4">
      <p class="text-sm text-white font-semibold mb-1">思い出のメッセージ</p>

      <!-- 実際のメッセージ内容 -->
      <p class="text-sm text-gray-300 leading-relaxed"><%= post.content %></p>
    </div>

    <!-- 投稿日 -->
    <div class="px-4 mt-2">
      <p class="text-xs text-gray-400">
        <%= post.photo_date.present? ? l(post.photo_date) : "撮影日未設定" %>
      </p>
    </div>

    <!-- 編集・削除ボタン（投稿者のみ表示） -->
      <% if post.user == current_user %>
        <div class="mt-3 text-right text-sm space-x-4">
          <%= link_to "編集", edit_post_path(post), class: "text-blue-400 font-medium" %>
          <%= link_to "削除", post_path(post),
                      method: :delete,
                      data: { confirm: "削除してもよろしいですか？", turbo: false },
                      class: "text-red-400 font-medium" %>
        </div>
      <% end %>
    </div>

  </div>
</div>
