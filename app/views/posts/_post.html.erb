<div class="flex gap-4 items-center bg-base-100 rounded-xl shadow p-4">
  <!-- サムネイル （クリックでモーダル表示）-->
  <button
    type="button"
    class="w-20 h-20 rounded-lg overflow-hidden bg-base-200 flex-shrink-0"
    data-action="click->modal#open"
    data-modal-id="<%= post.id %>"
    aria-label="思い出を開く"
  >
    <% if post.photos.any? && post.photos.first.image.attached? %>
      <%= image_tag post.photos.first.image, class: "w-full h-full object-cover", loading: "lazy", decoding: "async" %>
    <% end %>
  </button>

  <!-- 情報 -->
  <div class="flex-1">
    <p class="text-sm text-base-content/60">
      <%= post.photo_date ? l(post.photo_date) : "撮影日未設定" %>
    </p>

    <p class="font-semibold">
      <%= post.title.presence || "タイトル未設定" %>
    </p>
  </div>

  <!-- 編集 / 削除（自分の投稿だけ） -->
  <% if post.user == current_user %>
    <div class="flex items-center gap-2">
      <%= link_to "編集", edit_post_path(post),
            class: "btn btn-sm btn-outline rounded-full" %>

      <%= button_to "削除", post_path(post),
            method: :delete,
            form: { data: { turbo_confirm: "削除してもよろしいですか？" } },
            class: "btn btn-sm btn-outline btn-error rounded-full" %>
    </div>
  <% end %>
</div>
