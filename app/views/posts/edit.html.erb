<!-- 編集ページヘッダー抑制 -->
<% content_for :suppress_header, true %>
<!-- 編集ページカスタムヘッダー -->
<div class="fixed top-0 left-0 w-full z-50 flex items-center justify-between bg-base-300 text-base-content px-4 py-3 border-b border-base-200">
  <!-- キャンセル（戻る）ボタン -->
  <div class="w-20 flex-shrink-0">
    <%= link_to "キャンセル", "javascript:history.back()", class: "text-sm" %>
  </div>

  <!-- タイトル -->
  <h2 class="text-base font-bold text-center flex-grow truncate">
    思い出を編集
  </h2>

  <!-- 完了（保存）ボタン -->
  <div class="w-20 text-right flex-shrink-0">
    <button type="submit" form="edit-post-form" class="text-sm text-accent font-semibold">
      完了
    </button>
  </div>
</div>

<!-- 本体 -->
<div class="max-w-xl mx-auto px-4 pt-20 pb-24">

  <%= render "shared/form_errors", object: @post %>

  <%# --- 現在登録されている写真（削除不可・閲覧のみ） --- %>
  <div class="flex justify-center gap-2 mb-4">
    <% @post.photos.each do |photo| %>
      <div class="w-20 aspect-square rounded-md overflow-hidden">
        <%= image_tag cdn_image_path(photo.image), class: "w-full h-full object-cover", loading: "lazy" %>
      </div>
    <% end %>
  </div>

  <p class="text-xs text-base-content/60 text-center mb-2">
    思い出写真（変更できません）
  </p>

  <%# --- 投稿編集フォーム --- %>
  <%= form_with model: @post,
              local: true,
              html: { multipart: true, id: "edit-post-form" },
              data: { controller: "person-tags" } do |f| %>

    <%# --- 撮影日 --- %>
    <div class="mb-6">
      <%= f.label :photo_date, "撮影日", class: "label font-medium text-base-content" %>
      <%= f.date_field :photo_date, class: "input input-bordered w-full", required: true %>
    </div>

    <%# --- タイトル --- %>
    <div class="mb-6">
      <%= f.label :title, "タイトル", class: "label font-medium text-base-content" %>
      <%= f.text_field :title, class: "input input-bordered w-full" %>
    </div>

    <%# 誰が写っているか？ %>
    <%= render "person_tags_field", f: f %>

    <%# --- ひとことメッセージ --- %>
    <div class="mb-6">
      <%= f.label :content, "メッセージ", class: "label font-medium text-base-content" %>
      <%= f.text_area :content, rows: 4, class: "textarea textarea-bordered w-full" %>
    </div>

  <% end %>
</div>
