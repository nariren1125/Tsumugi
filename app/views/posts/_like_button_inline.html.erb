<% liked = post.post_likes.exists?(user: current_user) %>

<% if liked %>
  <%= button_to post_post_like_path(post, current_user.post_likes.find_by(post: post)),
      method: :delete,
      form: { data: { turbo_frame: dom_id(post, :like_button) } },
      class: "flex items-center space-x-1 text-error transition-colors" do %>

        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 24 24"
             fill="currentColor"
             class="w-6 h-6">
          <path d="M12 21s-7-4.35-9.5-8.28C.9 9.89 2.5 6.5 6 6.5c2.05 0 3.5 1.3 4 2.09.5-.79 1.95-2.09 4-2.09 3.5 0 5.1 3.39 3.5 6.22C19 16.65 12 21 12 21z"/>
        </svg>

        <span class="text-sm font-semibold">
          <%= post.post_likes.count %>
        </span>

  <% end %>

<% else %>

  <%= button_to post_post_likes_path(post),
      method: :post,
      form: { data: { turbo_frame: dom_id(post, :like_button) } },
      class: "flex items-center space-x-1 text-base-content/70 hover:text-error transition-colors" do %>

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.8"
             stroke="currentColor"
             class="w-6 h-6">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 21s-7-4.35-9.5-8.28C.9 9.89 2.5 6.5 6 6.5c2.05 0 3.5 1.3 4 2.09.5-.79 1.95-2.09 4-2.09 3.5 0 5.1 3.39 3.5 6.22C19 16.65 12 21 12 21z"/>
        </svg>

        <span class="text-sm font-semibold">
          <%= post.post_likes.count %>
        </span>

  <% end %>

<% end %>
