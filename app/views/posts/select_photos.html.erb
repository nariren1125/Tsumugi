<%# デフォルトヘッダー、デフォルト背景を制御 %>
<% content_for :suppress_header, true %>

<div class="relative min-h-screen">
  <!-- ===== ヘッダー ===== -->
  <%= render "shared/simple_header", title: "新規投稿" %>

  <% if current_family_group.present? %>
    <%# ===== グループありパターン ===== %>
  <main
    data-controller="photo-picker"
    data-photo-picker-max-files-value="5"
    class="relative max-w-xl mx-auto px-4 min-h-[100svh]"
  >
    <!-- ✅ 背景（intro時だけ表示する） -->
    <div
      data-photo-picker-target="background"
      class="absolute inset-0 z-0 pointer-events-none flex justify-center -translate-y-6"
    >
      <%= image_tag "post_select_bg.png",
            class: "h-full max-h-[640px] w-auto object-contain opacity-80",
            alt: "" %>
    </div>

    <!-- =========================================
         ✅ intro（写真を選ぶ画面）
         ========================================= -->
    <section
      data-photo-picker-target="intro"
      class="relative z-10 min-h-[calc(100svh-120px)] flex flex-col items-center pt-[13.5rem] pb-20"
    >
      <div class="w-40 mx-auto mb-4">
        <%= image_tag "tumugi_photo.png",
              alt: "ツムとムギが写真を撮っているイラスト",
              class: "w-full h-auto opacity-90 drop-shadow-sm" %>
      </div>

      <h2 class="text-lg font-semibold mb-2">
        思い出の写真を選ぼう
      </h2>

      <p class="text-sm text-base-content/70 mb-6 text-center">
        投稿できる写真は最大5枚までです。
      </p>

      <button
        type="button"
        class="btn btn-accent shadow-md rounded-full px-6 mt-2"
        data-action="photo-picker#openPicker"
      >
        写真を選ぶ
      </button>

      <!-- hidden form / input（DirectUpload） -->
      <%= form_with url: prepare_uploads_posts_path,
                    method: :post,
                    multipart: true,
                    data: { turbo: false, "photo-picker-target": "form" },
                    class: "hidden" do %>

        <%= hidden_field_tag :dropped_files_count, 0 %>

        <%= file_field_tag "post[images][]",
              multiple: true,
              accept: "image/*",
              direct_upload: true,
              data: {
                "photo-picker-target": "input",
                action: "change->photo-picker#handleFiles"
              } %>
      <% end %>
    </section>

    <!-- =========================================
        ✅ preview（選択後のプレビュー画面）
        ========================================= -->
    <section
      data-photo-picker-target="preview"
      class="hidden pt-6 pb-28"
    >
      <div class="space-y-3">
        <h2 class="text-base font-semibold">
          選択した写真の確認
        </h2>

        <%# ✅ 画像＋トーストを重ねるため relative を付ける %>
        <div class="relative">
          <%# ✅ 超過トースト %>
          <div
            data-photo-picker-target="dropNotice"
            class="hidden absolute top-2 left-1/2 -translate-x-1/2 z-20 w-[92%] max-w-sm
                  alert alert-warning shadow-md text-xs py-2
                  opacity-0 transition-opacity duration-300"
            role="alert"
          ></div>

          <%# ✅ 画像プレビュー %>
          <div class="overflow-x-auto snap-x snap-mandatory">
            <div class="flex gap-3 py-2">
              <%# JSでここに画像が入る %>
            </div>
          </div>
        </div>

        <p class="text-xs text-base-content/70 leading-relaxed">
          ※「選び直す」を押すと、選んだ写真は消えて写真選択画面に戻ります。
        </p>

        <div class="mt-3 flex gap-2">
          <button
            type="button"
            data-action="photo-picker#reselect"
            class="btn btn-outline normal-case flex-1"
          >
            選び直す
          </button>

          <button
            type="button"
            data-photo-picker-target="nextButton"
            data-action="photo-picker#next"
            class="btn btn-accent flex-1 hidden"
          >
            次へ
          </button>
        </div>
      </div>
    </section>
  </main>

  <% else %>
    <%# ===== グループなしパターン ===== %>
    <div class="max-w-xl mx-auto px-4 py-10 pb-24">
      <%= render "posts/no_family_group" %>
    </div>
  <% end %>
</div>
