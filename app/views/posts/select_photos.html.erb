<%# デフォルトヘッダーを抑制 %>
<% content_for :suppress_header, true %>

<div
  class="fixed inset-0 bg-base-100"
  data-controller="photo-picker"
>
  <!-- ===== ヘッダー ===== -->
  <header
    class="fixed top-0 left-0 w-full z-[100]
           flex items-center justify-between
           px-4 py-4 border-b bg-base-300"
  >
    <!-- キャンセル -->
    <button
      type="button"
      class="text-xl"
      data-action="photo-picker#cancel"
    >
      ×
    </button>

    <!-- タイトル -->
    <h1 class="text-base font-semibold">
      新規投稿
    </h1>

    <!-- 次へ -->
    <button
      type="button"
      class="text-sm font-semibold text-accent disabled:opacity-40"
      data-photo-picker-target="nextButton"
      data-action="photo-picker#next"
      disabled
    >
      次へ
    </button>
  </header>

  <!-- ===== メイン ===== -->
  <main class="pt-14 flex flex-col relative z-10">

    <!-- 選択中プレビュー（上部） -->
    <section
      class="aspect-square bg-black"
      data-action="click->photo-picker#openPicker"
    >
      <img
        data-photo-picker-target="preview"
        class="w-full h-full object-contain hidden"
        alt="選択中の写真"
      >
    </section>

    <!-- 写真一覧（グリッド） -->
    <section class="flex-1 overflow-y-auto p-1">
      <div
        class="grid grid-cols-4 gap-1"
        data-photo-picker-target="grid"
      >
        <%# JSでサムネイルを挿入 %>
      </div>
    </section>

  </main>

  <!-- ===== hidden input ===== -->

  <form
    action="<%= confirm_photos_posts_path %>"
    method="post"
    enctype="multipart/form-data"
    data-photo-picker-target="form"
    class="hidden"
  >
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <!-- ファイル選択用 input -->
    <input
    type="file"
    name="images[]"
    multiple
    class="hidden"
    data-photo-picker-target="input"
    data-action="change->photo-picker#handleFiles"
  >

</form>
