<!-- デフォルトのレイアウトを無効化 -->
<% content_for :suppress_header, true %>

<div class="fixed inset-0 bg-base-100 flex flex-col">

  <!-- ===== ヘッダー ===== -->
  <header
    class="flex-shrink-0
           flex items-center justify-between
           px-4 py-4 border-b bg-base-300"
  >
    <%= link_to "×", select_photos_posts_path,
          class: "text-xl font-semibold" %>

    <h1 class="text-base font-semibold">確認</h1>

    <div class="w-6"></div>
  </header>

  <!-- ===== プレビュー ===== -->
  <div class="flex-1 flex items-start justify-center px-4 pt-6 pb-30">
    <div class="w-full max-w-md">
      <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 py-6">
        <% @post.photos.each do |photo| %>
          <div class="min-w-full snap-center flex justify-center">
            <div
              class="aspect-square w-full
                     bg-base-200 rounded-xl overflow-hidden"
            >
              <%= image_tag photo.image,
                    class: "w-full h-full object-cover" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- ===== 次へボタン ===== -->
  <%= link_to new_post_path(draft_post_id: @post.id),
      class: "fixed bottom-28 right-4 z-50
              btn btn-accent px-6 shadow-lg" do %>
    次へ
  <% end %>

</div>
