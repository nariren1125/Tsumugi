<% content_for :suppress_header, true %>

<div data-controller="photo-confirm">
  <!-- ヘッダー -->
  <header class="flex justify-between items-center p-4">
    <%= link_to "×", select_photos_posts_path %>
    <h1>確認</h1>
    <%= link_to "次へ", new_post_path(draft_post_id: @post.id) %>
  </header>

  <!-- スライダー -->
   <div class="swiper">
    <div class="swiper-wrapper">
      <% @post.photos.each do |photo| %>
        <div class="swiper-slide">
          <%= image_tag photo.image, class: "w-full object-contain" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
