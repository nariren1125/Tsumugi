<div class="tsumugi-actions" id="post_actions_<%= post.id %>">
  
  <%# --- ❤️ いいねボタン --- %>
  <% if current_user.post_likes.exists?(post_id: post.id) %>
    <% like = current_user.post_likes.find_by(post_id: post.id) %>
    <%# form: { class: "inline-action" } を追加して横並び崩れを防ぎます %>
    <%= button_to post_post_like_path(post, like), method: :delete, form: { data: { turbo: true }, class: "inline-action" }, class: "action-btn like-btn liked" do %>
      <span class="icon">❤️</span>
      <%# N+1対策のため .count ではなく .size を使用します %>
      <span class="count"><%= post.post_likes.size %></span>
    <% end %>
  <% else %>
    <%= button_to post_post_likes_path(post), method: :post, form: { data: { turbo: true }, class: "inline-action" }, class: "action-btn like-btn" do %>
      <span class="icon">🤍</span>
      <span class="count"><%= post.post_likes.size %></span>
    <% end %>
  <% end %>

  <%# --- 💬 コメントボタン --- %>
  <%# 既存のクラス(btn btn-ghost)に加えて、横並び用のクラス(inline-action action-btn)も追加しています %>
  <button
    type="button"
    class="btn btn-ghost btn-sm action-btn comment-btn inline-action"
    data-controller="comments-sheet-opener"
    data-comments-sheet-opener-post-id-value="<%= post.id %>"
    data-action="click->comments-sheet-opener#open"
  >
    <span class="icon">💬</span>
    <span class="count" id="comments-count-<%= post.id %>"><%= post.comments.size %></span>
  </button>

</div>