<!-- 編集ページヘッダー抑制 -->
<% content_for :suppress_header, true %>

<!-- カスタムヘッダー -->
<div class="fixed top-0 left-0 w-full z-50 flex items-center justify-between bg-base-300 text-base-content px-4 py-3 border-b border-base-200">
  <!-- 戻るボタン -->
  <div class="w-20 flex-shrink-0">
    <%= link_to "←", family_settings_path, class: "text-xl", aria: { label: "設定に戻る" } %>
  </div>

  <!-- タイトル -->
  <h2 class="text-base font-bold text-center flex-grow truncate">
    お子さま情報の編集
  </h2>

  <!-- 右端スペース確保 -->
    <div class="w-20 flex-shrink-0"></div>
  </div>

<!-- 本体 -->
<div class="max-w-xl mx-auto px-4 pt-16 pb-24 space-y-6">
  <!-- エラーメッセージ -->
  <%= render "shared/form_errors", object: @child %>

  <!-- 編集フォーム -->
  <%= form_with model: @child, url: child_path(@child), method: :patch do |f| %>
    <div class="mb-3">
      <%= f.label :name, "お名前", class: "label-text font-semibold" %>
      <%= f.text_field :name, class: "input input-bordered w-full" %>
    </div>

    <div class="mb-6">
      <%= f.label :birth_date, "お誕生日", class: "label-text font-semibold" %>
      <%= f.date_field :birth_date, class: "input input-bordered w-full" %>
    </div>

    <!-- 更新ボタン（左側） -->
    <div class="flex gap-4 items-center">
      <%= f.submit "更新する", class: "btn btn-accent" %>

      <!-- 削除ボタンは form_with の外側だが、見た目上は同じ行に配置 -->
      <%= button_to "削除する",
            child_path(@child),
            method: :delete,
            data: { turbo: false, confirm: "削除してもよろしいですか？" },
            class: "btn btn-outline btn-error inline-block" %>
    </div>
  <% end %>

</div>
