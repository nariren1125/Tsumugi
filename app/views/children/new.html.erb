
<!-- 編集ページヘッダー抑制 -->
<% content_for :suppress_header, true %>

<!-- カスタムヘッダー -->
<div class="fixed top-0 left-0 w-full z-50 flex items-center justify-between bg-base-300 text-base-content px-4 py-3 border-b border-base-200">
  <!-- 戻るボタン -->
  <div class="w-20 flex-shrink-0">
    <%= link_to "←", family_settings_path, class: "text-xl", aria: { label: "家族設定に戻る" } %>
  </div>

  <!-- タイトル -->
  <h2 class="text-base font-bold text-center flex-grow truncate">
    お子さまの新規登録
  </h2>

  <!-- 右端スペース確保 -->
    <div class="w-20 flex-shrink-0"></div>
  </div>

<!-- 本体 -->
<div class="max-w-xl mx-auto px-4 pt-16 pb-24 space-y-6">

<%= form_with model: @child, url: children_path, local: true do |f| %>
  <div class="form-control mb-4">
    <%= f.label :name, "お名前", class: "label" %>
    <%= f.text_field :name, placeholder: "例）たろう", class: "input input-bordered w-full" %>
  </div>

  <div class="form-control mb-4">
    <%= f.label :birth_date, "お誕生日", class: "label" %>
    <%= f.date_field :birth_date, class: "input input-bordered w-full" %>
  </div>

  <%= f.submit "登録する", class: "btn btn-accent w-full" %>
<% end %>
