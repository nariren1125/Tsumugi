
<!-- 編集ページヘッダー抑制 -->
<% content_for :suppress_header, true %>

<!-- カスタムヘッダー -->
<div class="fixed top-0 left-0 w-full z-50 flex items-center justify-between bg-base-300 text-base-content px-4 py-3 border-b border-base-200">
  <!-- 戻るボタン -->
  <div class="w-20 flex-shrink-0">
    <%= link_to "←", mypage_path, class: "text-xl", aria: { label: "マイページに戻る" } %>
  </div>

  <!-- タイトル -->
  <h2 class="text-base font-bold text-center flex-grow truncate">
    プロフィールの編集
  </h2>

  <!-- 右端スペース確保 -->
    <div class="w-20 flex-shrink-0"></div>
  </div>



<!-- 本体 -->
<div class="max-w-xl mx-auto px-4 pt-16 pb-24 space-y-6">
  <!-- エラーメッセージ -->
  <%= render "shared/form_errors", object: @user %>

<!-- 編集フォーム -->
<%= form_with model: @user, url: mypage_path, method: :patch do |f| %>
  <div class="mb-3">
    <%= f.label :name, "名前", class: "label-text font-semibold" %>
    <%= f.text_field :name, class: "input input-bordered w-full" %>
  </div>

  <div class="mb-6">
    <%= f.label :role, "役割", class: "label-text font-semibold" %>
    <%= f.select :role,
          User.roles.keys.map { |role|
            [I18n.t("activerecord.attributes.user.roles.#{role}"), role]
          },
          {},
          class: "select select-bordered w-full"
    %>
  </div>

  <%= f.submit "保存", class: "btn btn-accent w-full" %>

<% end %>
