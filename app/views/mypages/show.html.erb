<%# デフォルトヘッダー、デフォルト背景を制御%>
<% content_for :suppress_header, true %>

<div class="relative min-h-screen">

  <!-- ===== ヘッダー ===== -->
  <% if @user == current_user %>
    <%= render "shared/simple_header", title: "マイページ" %>
  <% else %>
    <%= render "shared/back_header",
          title: @user.name,
          back_path: family_settings_path,
          show_meatball: true %>
  <% end %>

  <!-- ===== メインコンテンツ ===== -->
<div class="mt-4 space-y-4 bg-base-100 rounded-2xl p-5 shadow-sm border border-base-200 mb-8">

  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <p class="text-lg font-semibold text-base-content">
        <%= @user.name %>
        <span class="text-base-content/60 font-medium">
          （<%= @user.role_i18n %>）
        </span>
      </p>
  </div>

  <% if @user == current_user %>
    <%= link_to "編集", edit_mypage_path,
        class: "btn btn-sm btn-outline rounded-full" %>
  <% end %>
</div>

  <div class="mt-4 text-sm text-base-content/70">
    投稿数：<span class="font-medium text-base-content"><%= @posts.count %></span> 件
  </div>

</div>

<div class="mb-3 px-4">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold">
      <%= @user == current_user ? "あなたの思い出" : "#{@user.name}の思い出" %>
    </h2>

    <%= form_with url: request.path, method: :get, local: true do %>
      <select
        name="year"
        class="select select-sm select-bordered"
        onchange="this.form.submit()"
      >
        <option value="">すべて</option>
        <% @years.each do |y| %>
          <option value="<%= y %>" <%= "selected" if @selected_year.to_s == y.to_s %>>
            <%= y %>年
          </option>
        <% end %>
      </select>
    <% end %>
  </div>
</div>

<%# ===== 投稿一覧 ===== %>
<div class="space-y-4 pb-24" data-controller="modal">
  <%= render @posts %>
</div>

<%# ✅ モーダルは最後にまとめて %>
<% @posts.each do |post| %>
  <%= render "posts/modal", post: post %>
<% end %>
