<h1 class="text-sm text-base-content/60 mb-2">
  マイページ
</h1>

<div class="bg-base-200 rounded-2xl p-5 mb-8">
  <p class="text-lg font-semibold">
    <%= @user.name %>
  </p>

  <div class="mt-2">
    <span class="inline-block px-3 py-1 rounded-full text-xs bg-base-300">
      <%= t("activerecord.attributes.user.role.#{@user.role}") %>
    </span>
  </div>

  <%= link_to "編集",
        edit_mypage_path,
        class: "btn btn-sm btn-outline mt-4" %>
</div>

<h2 class="text-sm font-semibold mb-3">
  あなたの思い出
</h2>

<div class="space-y-4">
  <%= render @posts %>
</div>
