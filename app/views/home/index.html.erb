<div class="bg-base-100">
  <!-- HERO：ここを1画面にする（モバイル対応で100svh） -->
  <section class="relative min-h-[100svh] overflow-hidden bg-gradient-to-b from-base-200/70 to-base-100">
    <!-- うっすら装飾（任意：消してOK） -->
    <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl"></div>

    <div class="min-h-[100svh] flex flex-col items-center text-center">
      <!-- 中央寄せ：主役はログイン -->
      <div class="max-w-lg w-full px-6 pt-10 flex-1 flex flex-col justify-center">
        <%= image_tag "tsumugi_logo.png",
                      alt: "Tsumugi ロゴ",
                      class: "mx-auto mb-5 w-56 sm:w-64 drop-shadow-sm" %>

        <p class="text-base-content/75 text-base leading-relaxed">
          撮る人も、写る人も。<br>
          家族の思い出を、ふたりで紡ぐアルバム。
        </p>

        <div class="mt-8">
          <%= link_to "LINEでログイン / 新規登録",
                      line_login_path,
                      class: "btn btn-accent w-full h-12 text-base font-semibold shadow-sm",
                      data: { turbo: false } %>

          <!-- 安心情報（誘導の前に置くと迷いが減る） -->
          <p class="mt-3 text-xs text-base-content/60 leading-relaxed">
            ※ LINEアカウントで認証します。パスワード登録は不要です。
          </p>

          <!-- スクロール誘導：少し控えめに -->
          <a href="#about"
             class="mt-6 text-sm text-base-content/50 inline-flex items-center justify-center gap-2 hover:text-base-content/70">
            <span class="animate-bounce">↓</span>
            <span>Tsumugiについて</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 説明：セクション間の余白リズムを作る -->
  <section id="about" class="flex flex-col items-center scroll-mt-8">
    <div class="max-w-lg w-full px-6 pt-10 pb-8 space-y-6">
      <!-- About：読みやすいように文章を2段に -->
      <div class="card bg-base-200/60 border border-base-300/60 shadow-sm text-left">
        <div class="card-body">
          <h2 class="font-semibold">Tsumugi（つむぎ）とは</h2>

          <p class="text-sm text-base-content/80 leading-relaxed mt-2">
            写真を撮る人と、写る人。<br>
            どちらか一方に偏ることなく、夫婦・パートナーが一緒に思い出を残していくための家族アルバムです。
          </p>

          <p class="text-sm text-base-content/70 leading-relaxed mt-3">
            日々の何気ない瞬間を、「ふたりで残す時間」へ。Tsumugiは、そんな体験を届けます。
          </p>
        </div>
      </div>

      <!-- できること：カードはそのまま、余白と視認性だけ整える -->
      <div class="space-y-4">
        <h2 class="font-semibold text-left">できること</h2>

        <div class="card bg-base-100 border border-base-300/60 shadow-sm text-left">
          <div class="card-body">
            <div class="flex items-start gap-3">
              <span class="text-base">📷</span>
              <div>
                <h3 class="font-semibold">ふたりで思い出を投稿</h3>
                <p class="text-sm text-base-content/75 leading-relaxed mt-2">
                  撮る人・写る人が自然に入れ替わり、写真に残る家族のバランスを整えます。
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300/60 shadow-sm text-left">
          <div class="card-body">
            <div class="flex items-start gap-3">
              <span class="text-base">🐿️</span>
              <div>
                <h3 class="font-semibold">日々の記録が、そのままアルバムに</h3>
                <p class="text-sm text-base-content/75 leading-relaxed mt-2">
                  投稿していくと、思い出が整理されます。アルバムを作るときは、現像するだけで完成します。
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300/60 shadow-sm text-left">
          <div class="card-body">
            <div class="flex items-start gap-3">
              <span class="text-base">🧶</span>
              <div>
                <h3 class="font-semibold">ふたりの気持ちを記録</h3>
                <p class="text-sm text-base-content/75 leading-relaxed mt-2">
                  写真と一緒に、その日の想いや言葉を残せます。あとから見返したとき、当時の会話や気持ちがやさしくよみがえります。
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA：カード連打の後に“区切り”を作る -->
      <div class="pt-2">
        <a href="#guide" class="btn btn-outline w-full text-base">
          はじめてご利用の方へ ↓
        </a>
      </div>
    </div>
  </section>

  <!-- はじめての使い方：分割カードで見やすく -->
<section id="guide" class="flex flex-col items-center scroll-mt-8">
  <div class="max-w-lg w-full px-6 pb-14 space-y-4">
    <div class="text-left">
      <h2 class="font-semibold">はじめての使い方</h2>
      <p class="text-sm text-base-content/70 leading-relaxed mt-2">
        はじめての方も迷わないように、まずはこの順番で進めてみてください。
      </p>
    </div>

    <div class="card bg-base-200/50 border border-base-300/60 shadow-sm text-left">
      <div class="card-body">
        <div class="flex items-start gap-3">
          <span class="text-base">①</span>
          <div>
            <h3 class="font-semibold">LINEでログイン</h3>
            <p class="text-sm text-base-content/70 leading-relaxed mt-2">
              LINEアカウントでそのまま利用できます。パスワード登録は不要です。
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-200/50 border border-base-300/60 shadow-sm text-left">
      <div class="card-body">
        <div class="flex items-start gap-3">
          <span class="text-base">②</span>
          <div>
            <h3 class="font-semibold">グループを作成する</h3>
            <p class="text-sm text-base-content/70 leading-relaxed mt-2">
              設定画面から家族グループを作成します。グループを作ると、アルバムや投稿などの機能が使えるようになります。
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-200/50 border border-base-300/60 shadow-sm text-left">
      <div class="card-body">
        <div class="flex items-start gap-3">
          <span class="text-base">③</span>
          <div>
            <h3 class="font-semibold">一緒に紡ぐメンバーを招待</h3>
            <p class="text-sm text-base-content/70 leading-relaxed mt-2">
              設定画面の「家族一覧」から、グループに参加するメンバーを招待できます。
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-200/50 border border-base-300/60 shadow-sm text-left">
      <div class="card-body">
        <div class="flex items-start gap-3">
          <span class="text-base">④</span>
          <div>
            <h3 class="font-semibold">お子さまを登録する（任意）</h3>
            <p class="text-sm text-base-content/70 leading-relaxed mt-2">
              「お子さま一覧」から追加できます。思い出が家族の成長記録として整理しやすくなります。
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-200/50 border border-base-300/60 shadow-sm text-left">
      <div class="card-body">
        <div class="flex items-start gap-3">
          <span class="text-base">⑤</span>
          <div>
            <h3 class="font-semibold">思い出を投稿する</h3>
            <p class="text-sm text-base-content/70 leading-relaxed mt-2">
              投稿すると、家族メンバーにTsumugi公式アカウントから通知が届き、アルバムに反映されます。
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
</div>
