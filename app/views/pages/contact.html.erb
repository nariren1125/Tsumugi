<% content_for :page_title, "お問い合わせ" %>

<div class="max-w-xl mx-auto px-4 pt-16 pb-24">
  <h1 class="text-xl font-bold mb-2 text-center">お問い合わせ</h1>
  <p class="text-center text-sm text-base-content/70 mb-6">
    ご不明点やご意見がございましたらお気軽にご連絡ください
  </p>

  <div class="bg-base-100 rounded-box shadow p-6 space-y-5">
    <div>
      <label class="label">
        <span class="label-text font-semibold">お名前</span>
      </label>
      <input type="text" class="input input-bordered w-full" placeholder="山田 太郎" />
    </div>

    <div>
      <label class="label">
        <span class="label-text font-semibold">メールアドレス</span>
      </label>
      <input type="email" class="input input-bordered w-full" placeholder="example@email.com" />
    </div>

    <div>
      <label class="label">
        <span class="label-text font-semibold">お問い合わせ内容</span>
      </label>
      <textarea class="textarea textarea-bordered w-full h-40" placeholder="お問い合わせ内容をご記入ください"></textarea>
    </div>

    <button class="btn btn-accent w-full">送信</button>

    <p class="text-center text-xs text-base-content/60">
      通常1〜2営業日以内にご返信いたします
    </p>
  </div>
</div>
